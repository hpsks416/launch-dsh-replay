{
  "name": "dsh-session-sync-flush",
  "version": "0.2.0",
  "description": "DSH 插件：关键会话事件后立即 flush 日志，缩小崩溃丢对话窗口（桌面端 DSH 0.2.2-rc.1 适配版）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "^0.2.2-rc.1",
      "dshReleases": {
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  }
}
